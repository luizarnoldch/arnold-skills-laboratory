# Skills Lab — Docker stack environment
# Copy to .env in repo root: cp .env.docker.example .env

# LLM runtime (chavez) — required for evals and optimize rewrite
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Cursor Cloud Agents (optional; requires CHAVEZ_PUBLIC_BASE_URL tunnel)
# LLM_PROVIDER=cursor
# CURSOR_API_KEY=
# CURSOR_BASE_URL=https://api.cursor.com
# CURSOR_MODEL=auto
# CHAVEZ_PUBLIC_BASE_URL=https://your-tunnel.example.com

# Host path bind-mounted into chavez as /workspace (eval sandboxes)
WORKSPACE_HOST_PATH=./workspace

# Runtime environment label
APP_ENV=production

# Set to true to surface chavez 500 error details in API responses (debugging)
# CHAVEZ_EXPOSE_INTERNAL_ERRORS=true

# MCP client HTTP timeout (skills-lab-mcp container)
# MCP_HTTP_TIMEOUT=30s
