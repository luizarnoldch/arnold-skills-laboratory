{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-laboratory.local/schema/grading.schema.json",
  "title": "EvalGrading",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_results", "summary"],
  "properties": {
    "index": { "type": "integer", "minimum": 1 },
    "eval_id": { "type": "integer" },
    "eval_slug": { "type": "string" },
    "config": { "type": "string" },
    "run": { "type": "integer" },
    "path": { "type": "string" },
    "assertion_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "passed", "evidence"],
        "properties": {
          "text": { "type": "string" },
          "passed": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "total", "pass_rate"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
