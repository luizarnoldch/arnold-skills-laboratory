{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-laboratory.local/schema/timing.schema.json",
  "title": "IterationTimingStack",
  "description": "Stacked timing entries with stable index linking each execution to its run directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runs"],
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "eval_id", "eval_slug", "config", "run", "path", "total_tokens", "duration_ms"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "eval_id": { "type": "integer", "minimum": 1 },
          "eval_slug": { "type": "string", "minLength": 1 },
          "config": { "type": "string", "enum": ["with_skill", "without_skill", "old_skill"] },
          "run": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "provider": { "type": "string" },
          "exit_code": { "type": "integer" },
          "timed_out": { "type": "boolean" }
        }
      }
    }
  }
}
