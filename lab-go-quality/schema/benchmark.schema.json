{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-laboratory.local/schema/benchmark.schema.json",
  "title": "IterationBenchmark",
  "description": "Aggregated iteration stats. delta is with_skill minus without_skill when present, else old_skill (skill-snapshot baseline).",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_summary"],
  "properties": {
    "run_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_skill", "delta", "baseline"],
      "properties": {
        "with_skill": { "$ref": "#/$defs/configStats" },
        "without_skill": {
          "$ref": "#/$defs/configStats",
          "description": "Baseline with no skill. Empty/zero metrics when the iteration used old_skill instead."
        },
        "old_skill": {
          "$ref": "#/$defs/configStats",
          "description": "Baseline against skill-snapshot/ (previous skill version)."
        },
        "baseline": {
          "type": "string",
          "enum": ["without_skill", "old_skill", "none"],
          "description": "Which config delta was computed against."
        },
        "delta": {
          "type": "object",
          "description": "with_skill − baseline (without_skill preferred, else old_skill)",
          "additionalProperties": false,
          "required": ["pass_rate", "time_seconds", "tokens"],
          "properties": {
            "pass_rate": { "type": "number" },
            "time_seconds": { "type": "number" },
            "tokens": { "type": "number" }
          }
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "stddev"],
      "properties": {
        "mean": { "type": "number" },
        "stddev": { "type": "number" }
      }
    },
    "configStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_rate", "time_seconds", "tokens"],
      "properties": {
        "pass_rate": { "$ref": "#/$defs/metric" },
        "time_seconds": { "$ref": "#/$defs/metric" },
        "tokens": { "$ref": "#/$defs/metric" }
      }
    }
  }
}
